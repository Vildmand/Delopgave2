    {
      "id": 5,
      "type": "timeseries",
      "title": "Fugt over tid",
      "description": "Alle målinger i perioden, én linje pr. enhed. De stiplede linjer er grænserne 55 og 60 %RH.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fugt-db"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 5
