    {
      "id": 3,
      "type": "stat",
      "title": "Sekunder siden seneste måling",
      "description": "Pi'en sender hvert 5. sekund. Over 15 sekunder betyder, at Pi'en eller netværket er stoppet.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fugt-db"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fugt-db"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT EXTRACT(EPOCH FROM (now() AT TIME ZONE 'UTC') - max(received_at)) AS \"Sekunder\" FROM measurement"
        }
