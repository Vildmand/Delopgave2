      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fugt-db"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT received_at AS time, humidity AS value, device_id AS metric\nFROM measurement\nWHERE $__timeFilter(received_at)\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: %RH",
          "min": 0,
