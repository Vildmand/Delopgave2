    {
      "id": 6,
      "type": "stat",
      "title": "MTTA (median)",
      "description": "Mean time to acknowledge: median tid fra opened_at til acknowledged_at for alarmer åbnet i perioden. Svarer til mål 6 i rapporten.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fugt-db"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fugt-db"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM acknowledged_at - opened_at)) AS \"MTTA\"\nFROM alarm WHERE acknowledged_at IS NOT NULL AND $__timeFilter(opened_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 300
              },
              {
                "color": "red",
                "value": 900
              }
            ]
          },
          "noValue": "Ingen kvitterede alarmer",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
