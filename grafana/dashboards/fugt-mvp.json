  "description": "Læser direkte fra PostgreSQL-tabellerne measurement og alarm. Ingen ændringer i API'et.",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Seneste fugt",
      "description": "Den nyeste måling fra tabellen measurement. Farverne følger reglerne i rules.py: under 55 grøn, 55–60 gul, over 60 rød.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fugt-db"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fugt-db"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT humidity AS \"Fugt\" FROM measurement ORDER BY id DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: %RH",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 55
              },
              {
                "color": "red",
                "value": 60.0001
              }
            ]
          },
          "noValue": "–",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
