    {
      "id": 9,
      "type": "table",
      "title": "Alarmer",
      "description": "De 20 nyeste alarmer med alarmens tre tidspunkter.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fugt-db"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fugt-db"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT id AS \"#\", device_id AS \"Enhed\", humidity AS \"Fugt\",\n  opened_at AS \"Åbnet\", acknowledged_at AS \"Kvitteret\", closed_at AS \"Normal igen\",\n  CASE WHEN closed_at IS NOT NULL THEN 'normal igen'\n       WHEN acknowledged_at IS NOT NULL THEN 'kvitteret'\n       ELSE 'åben' END AS \"Tilstand\"\nFROM alarm ORDER BY id DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Tilstand"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "åben": {
                        "color": "red",
                        "index": 0
                      },
                      "kvitteret": {
                        "color": "yellow",
                        "index": 1
                      },
                      "normal igen": {
                        "color": "green",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    }
